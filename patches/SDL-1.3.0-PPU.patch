--- SDL-1.3.0/src/video/psl1ght/SDL_PSL1GHTmouse.c	1969-12-31 21:00:00
+++ SDL-1.3.0/src/video/psl1ght/SDL_PSL1GHTmouse.c	2026-09-05 18:29:53
@@ -0,0 +1,139 @@
+/*
+    SDL - Simple DirectMedia Layer
+    Copyright (C) 1997-2010 Sam Lantinga
+
