diff -Nru SDL-1.3.0/src/video/psl1ght/SDL_PSL1GHTmodes.c SDL-1.3.0/src/video/psl1ght/SDL_PSL1GHTmodes.c
--- SDL-1.3.0/src/video/psl1ght/SDL_PSL1GHTmodes.c	1969-12-31 21:00:00
+++ SDL-1.3.0/src/video/psl1ght/SDL_PSL1GHTmodes.c	2026-09-05 18:29:53
@@ -0,0 +1,183 @@
+/*
